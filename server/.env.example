# ==============================================================================
# RENTORA BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection
# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/rentora
# For MongoDB Atlas (Production Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rentora?retryWrites=true&w=majority&appName=RentoraCluster
MONGODB_URI=mongodb://127.0.0.1:27017/rentora

# Authentication & JWT Security
# Generate a cryptographically secure 64-char key: openssl rand -base64 48
JWT_SECRET=rentora_super_secure_production_signing_key_replace_with_strong_secret
JWT_EXPIRES_IN=7d

# Cross-Origin Resource Sharing (CORS)
# Primary client deployment URL
CLIENT_URL=http://localhost:5173
# Additional production domains (comma-separated):
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rentora.edu,https://rentora-app.vercel.app

# System Audit Ledger Security
ENFORCE_AUDIT_LEDGER_INTEGRITY=true
